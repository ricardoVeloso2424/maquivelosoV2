# =============================================================================
# MaquiVeloso — production environment TEMPLATE
# =============================================================================
# Copy to `.env` ON THE SERVER and fill in the real values there.
# NEVER commit a real .env. This file holds placeholders only — no secrets.
# After editing, run: php artisan key:generate && php artisan optimize
# =============================================================================

APP_NAME="MaquiVeloso"
APP_ENV=production
# Generate on the server with: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# Public HTTPS URL of the site (used to build absolute links & cookies)
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging: keep production quiet but useful. `daily` rotates log files.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Public self-registration is OFF in production. Create admins with:
#   php artisan admin:create
REGISTRATION_ENABLED=false

# --- Database (MySQL/MariaDB) -------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maquiveloso
DB_USERNAME=maquiveloso
DB_PASSWORD=

# --- Session / cookies --------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Require HTTPS for the session cookie (set to true once TLS is active)
SESSION_SECURE_COOKIE=true
# CSRF mitigation: "lax" is correct for this site (no cross-site POSTs)
SESSION_SAME_SITE=lax

# --- Cache / queue ------------------------------------------------------------
# Database stores keep the deployment dependency-free (no Redis required).
CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log

# Uploads are served as relative /storage/... URLs via `php artisan storage:link`.
# Keep "local" so image URLs stay domain-agnostic and HTTPS-safe.
FILESYSTEM_DISK=local

# --- Mail ---------------------------------------------------------------------
# The app does not send email today (no order/contact backend). Configure this
# only if you later enable email features. `log` is a safe inert default.
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
